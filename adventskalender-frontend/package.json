{
    "name": "adventskalender-frontend",
    "version": "2024.12.1",
    "private": true,
    "dependencies": {
        "@radix-ui/react-dialog": "^1.3.1",
        "@radix-ui/react-label": "^2.1.17",
        "@radix-ui/react-progress": "^1.2.1",
        "@radix-ui/react-select": "^2.4.1",
        "@radix-ui/react-separator": "^1.2.0",
        "@radix-ui/react-slot": "^1.5.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.4.0",
        "lucide-react": "^0.577.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-router": "^7.18.5",
        "react-router-dom": "^7.18.5",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.7.0",
        "tailwindcss-animate": "^1.0.7",
        "zod": "^4.6.7",
        "zxcvbn": "^4.4.2"
    },
    "devDependencies": {
        "@babel/plugin-transform-private-property-in-object": "^7.29.7",
        "@eslint/compat": "^2.1.1",
        "@eslint/eslintrc": "^3.3.7",
        "@eslint/js": "^10.0.1",
        "@tailwindcss/postcss": "^4.3.5",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/jest": "^30.0.0",
        "@types/preval.macro": "^3.0.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/react-router-dom": "^5.3.3",
        "@types/react-test-renderer": "^19.3.1",
        "@types/zxcvbn": "^4.4.5",
        "@typescript-eslint/eslint-plugin": "^8.72.1",
        "@typescript-eslint/parser": "^8.72.1",
        "@vitejs/plugin-react": "^5.2.0",
        "autoprefixer": "^10.6.2",
        "browserslist-to-esbuild": "^2.1.1",
        "eslint": "^10.14.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "globals": "^17.14.0",
        "husky": "^9.1.7",
        "jest": "^30.5.2",
        "jest-environment-jsdom": "^30.5.2",
        "postcss": "^8.5.32",
        "prettier": "^3.9.10",
        "react-test-renderer": "^19.3.1",
        "tailwindcss": "^4.3.5",
        "ts-jest": "^29.4.15",
        "typescript": "^5.9.3",
        "vite": "^7.3.7",
        "vite-tsconfig-paths": "^5.1.4"
    },
    "overrides": {
        "vite": {
            "rollup": "npm:@rollup/wasm-node"
        }
    },
    "scripts": {
        "start": "vite",
        "preview": "vite preview",
        "test": "jest",
        "build": "tsc && vite build",
        "check-format": "prettier --list-different \"{{public,src,scripts,types},.}/**/*.{js,jsx,ts,tsx,md,scss,css,json,htm,html}\" .prettierrc",
        "format": "prettier --write \"{{public,src,scripts,types},.}/**/*.{js,jsx,ts,tsx,md,scss,css,json,htm,html}\" .prettierrc",
        "lint": "eslint --format stylish src/**/*.{ts,tsx}",
        "lint:fix": "eslint --format stylish src/**/*.{ts,tsx} --fix",
        "prepare": "cd .. && husky adventskalender-frontend/.husky"
    },
    "jest": {
        "preset": "ts-jest/presets/js-with-ts",
        "testEnvironment": "jest-environment-jsdom",
        "moduleNameMapper": {
            "^@/(.*)$": "<rootDir>/src/$1",
            "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/__mocks__/fileMock.js",
            "\\.(css|less)$": "<rootDir>/__mocks__/styleMock.js"
        },
        "setupFiles": [
            "<rootDir>/src/test/setup.ts"
        ],
        "setupFilesAfterEnv": [
            "<rootDir>/src/setupTests.ts"
        ]
    }
}
